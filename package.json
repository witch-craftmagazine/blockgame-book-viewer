{
  "name": "blockgame-book-viewer",
  "version": "1.0.0",
  "description": "High-fidelity, modular blockgame written book web emulator, renderer, and web component.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witch-craftmagazine/blockgame-book-viewer.git"
  },
  "type": "module",
  "main": "./dist/blockgame-book-viewer.umd.cjs",
  "module": "./dist/blockgame-book-viewer.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/blockgame-book-viewer.js",
      "require": "./dist/blockgame-book-viewer.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "minecraft",
    "book",
    "viewer",
    "emulator",
    "canvas",
    "web-component",
    "stendhal",
    "cmi",
    "bookcopy"
  ],
  "author": "sentientwitch-craftmagazine",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:vitest": "vitest run"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fontsource/unifont": "^5.3.0",
    "jszip": "^3.10.2"
  }
}
